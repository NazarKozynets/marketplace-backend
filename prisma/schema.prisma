// Prisma schema for the Vieux Fou marketplace

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum Role {
  USER
  SELLER
  ADMIN
}

enum SellerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  MODERATION
  ACTIVE
  SOLD_OUT
  ARCHIVED
  REJECTED
}

enum ProductCondition {
  NEW
  LIKE_NEW
  USED
  VINTAGE
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PostType {
  PRODUCT
  OUTFIT
  COLLECTION
  EDITORIAL
}

enum EventType {
  PRODUCT_VIEW
  PRODUCT_CLICK
  PRODUCT_FAVORITE
  PRODUCT_ADD_TO_CART
  PRODUCT_PURCHASE
  SHOP_VIEW
  SEARCH
  FILTER_APPLIED
  POST_VIEW
  POST_LIKE
}

enum SubscriptionPlan {
  FREE
  PRO
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PAST_DUE
}

enum PromotionStatus {
  ACTIVE
  PAUSED
  FINISHED
}

// -----------------------------------------------------------------------------
// Identity & Auth
// -----------------------------------------------------------------------------

model User {
  id           String @id @default(uuid())
  shortId      String @unique @default(cuid())
  email        String @unique
  passwordHash String
  role         Role   @default(USER)

  firstName String?
  lastName  String?
  avatarUrl String?
  phone     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seller        Seller?
  refreshTokens RefreshToken[]

  orders    Order[]
  reviews   Review[]
  favorites Favorite[]

  posts     Post[]
  postLikes PostLike[]
  events    UserEvent[]

  @@index([role])
  @@index([email])
}

model RefreshToken {
  id        String    @id @default(uuid())
  shortId   String    @unique @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// -----------------------------------------------------------------------------
// Sellers & Shops
// -----------------------------------------------------------------------------

model Seller {
  id     String       @id @default(uuid())
  shortId String      @unique @default(cuid())
  userId String       @unique
  status SellerStatus @default(PENDING)

  displayName String?
  bio         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  shops         Shop[]
  subscriptions SellerSubscription[]

  @@index([status])
}

model Shop {
  id          String  @id @default(uuid())
  shortId     String  @unique @default(cuid())
  name        String
  slug        String  @unique
  description String?
  logoUrl     String?
  bannerUrl   String?
  instagram   String?
  telegram    String?

  ownerId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner      Seller             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  products   Product[]
  posts      Post[]
  outfits    Outfit[]
  promotions ProductPromotion[]
  events     UserEvent[]

  @@index([ownerId])
  @@index([name])
  @@index([slug])
}

// -----------------------------------------------------------------------------
// Catalog
// -----------------------------------------------------------------------------

model Product {
  id          String @id @default(uuid())
  shortId     String @unique @default(cuid())
  title       String
  description String

  price     Decimal           @db.Decimal(12, 2)
  brand     String
  category  String
  style     String?
  condition ProductCondition?
  status    ProductStatus     @default(DRAFT)

  tags       String[] @default([])
  attributes Json     @default("{}")

  shopId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  variants ProductVariant[]
  images   ProductImage[]

  orderItems OrderItem[]
  reviews    Review[]
  favorites  Favorite[]

  posts       ProductPost[]
  collections CollectionItem[]
  outfits     OutfitItem[]

  events UserEvent[]

  recommendationsFrom ProductRecommendation[] @relation("ProductRecommendations")
  recommendationsTo   ProductRecommendation[] @relation("RelatedProducts")

  promotions ProductPromotion[]

  @@index([shopId])
  @@index([brand])
  @@index([category])
  @@index([style])
  @@index([status])
  @@index([condition])
  @@index([title])
  @@index([price])
  @@index([createdAt])
}

model ProductVariant {
  id        String @id @default(uuid())
  shortId   String @unique @default(cuid())
  productId String

  size  String?
  color String?
  stock Int      @default(1)
  price Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([productId])
  @@index([size])
  @@index([color])
}

model ProductImage {
  id        String @id @default(uuid())
  shortId   String @unique @default(cuid())
  productId String

  url       String
  alt       String?
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([sortOrder])
}

// -----------------------------------------------------------------------------
// Orders & Payments
// -----------------------------------------------------------------------------

model Order {
  id     String @id @default(uuid())
  shortId String @unique @default(cuid())
  userId String

  status     OrderStatus @default(PENDING)
  totalPrice Decimal     @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items    OrderItem[]
  payment  Payment?
  delivery Delivery?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String  @id @default(uuid())
  shortId   String  @unique @default(cuid())
  orderId   String
  productId String
  variantId String?

  quantity Int
  price    Decimal @db.Decimal(12, 2)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model Payment {
  id      String @id @default(uuid())
  shortId String @unique @default(cuid())
  orderId String @unique

  status            PaymentStatus @default(PENDING)
  provider          String?
  providerPaymentId String?
  amount            Decimal       @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([providerPaymentId])
}

model Delivery {
  id      String @id @default(uuid())
  shortId String @unique @default(cuid())
  orderId String @unique

  provider       String?
  trackingNumber String?
  city           String?
  warehouse      String?
  recipientName  String?
  recipientPhone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([trackingNumber])
}

// -----------------------------------------------------------------------------
// Engagement
// -----------------------------------------------------------------------------

model Review {
  id        String @id @default(uuid())
  shortId   String @unique @default(cuid())
  userId    String
  productId String

  rating  Int
  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@index([rating])
}

model Favorite {
  id        String   @id @default(uuid())
  shortId   String   @unique @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@index([userId])
}

// -----------------------------------------------------------------------------
// Content: Feed, Posts, Collections, Outfits
// -----------------------------------------------------------------------------

model Post {
  id String @id @default(uuid())
  shortId String @unique @default(cuid())

  shopId   String?
  authorId String

  type       PostType
  title      String?
  text       String?
  coverImage String?
  published  Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop   Shop? @relation(fields: [shopId], references: [id], onDelete: SetNull)
  author User  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  products ProductPost[]
  likes    PostLike[]
  events   UserEvent[]

  @@index([shopId])
  @@index([authorId])
  @@index([type])
  @@index([published])
  @@index([createdAt])
}

model ProductPost {
  id        String @id @default(uuid())
  shortId   String @unique @default(cuid())
  postId    String
  productId String

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([postId, productId])
  @@index([productId])
}

model PostLike {
  id        String   @id @default(uuid())
  shortId   String   @unique @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
  @@index([userId])
}

model Collection {
  id String @id @default(uuid())
  shortId String @unique @default(cuid())

  title       String
  slug        String  @unique
  description String?
  coverImage  String?
  isFeatured  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items CollectionItem[]

  @@index([isFeatured])
  @@index([slug])
}

model CollectionItem {
  id           String @id @default(uuid())
  shortId      String @unique @default(cuid())
  collectionId String
  productId    String
  sortOrder    Int    @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([collectionId, productId])
  @@index([productId])
  @@index([sortOrder])
}

model Outfit {
  id String @id @default(uuid())
  shortId String @unique @default(cuid())

  title       String
  description String?
  coverImage  String?
  shopId      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop  Shop?        @relation(fields: [shopId], references: [id], onDelete: SetNull)
  items OutfitItem[]

  @@index([shopId])
  @@index([createdAt])
}

model OutfitItem {
  id        String @id @default(uuid())
  shortId   String @unique @default(cuid())
  outfitId  String
  productId String

  position  String?
  sortOrder Int     @default(0)

  outfit  Outfit  @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([outfitId, productId])
  @@index([productId])
  @@index([sortOrder])
}

// -----------------------------------------------------------------------------
// Analytics & Recommendations
// -----------------------------------------------------------------------------

model UserEvent {
  id String @id @default(uuid())
  shortId String @unique @default(cuid())

  userId    String?
  sessionId String?

  type EventType

  productId String?
  shopId    String?
  postId    String?

  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  shop    Shop?    @relation(fields: [shopId], references: [id], onDelete: SetNull)
  post    Post?    @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([sessionId])
  @@index([type])
  @@index([productId])
  @@index([shopId])
  @@index([postId])
  @@index([createdAt])
}

model ProductRecommendation {
  id String @id @default(uuid())
  shortId String @unique @default(cuid())

  productId String
  relatedId String

  score  Float   @default(0)
  reason String?

  createdAt DateTime @default(now())

  product Product @relation("ProductRecommendations", fields: [productId], references: [id], onDelete: Cascade)
  related Product @relation("RelatedProducts", fields: [relatedId], references: [id], onDelete: Cascade)

  @@unique([productId, relatedId])
  @@index([productId])
  @@index([relatedId])
  @@index([score])
}

// -----------------------------------------------------------------------------
// Seller Monetization
// -----------------------------------------------------------------------------

model SellerSubscription {
  id String @id @default(uuid())
  shortId String @unique @default(cuid())

  sellerId String
  plan     SubscriptionPlan   @default(FREE)
  status   SubscriptionStatus @default(ACTIVE)

  startsAt DateTime  @default(now())
  endsAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@index([plan])
  @@index([status])
  @@index([startsAt])
  @@index([endsAt])
}

model ProductPromotion {
  id String @id @default(uuid())
  shortId String @unique @default(cuid())

  productId String
  shopId    String

  status   PromotionStatus @default(ACTIVE)
  priority Int             @default(1)

  startsAt DateTime
  endsAt   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  shop    Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([shopId])
  @@index([status])
  @@index([priority])
  @@index([startsAt, endsAt])
}
